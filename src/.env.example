# Variables de entorno del sistema. Ninguna es secreta y todas tienen valor por omisión.

# API (src/api/app.py): orígenes permitidos por CORS, separados por coma. Por omisión "*".
AMT_CORS_ORIGINS=http://localhost:8765

# Hilos de cálculo de PyTorch. Conviene igualarlos a los núcleos disponibles; sin límite,
# en un contenedor con cuota de CPU la conversión puede tardar 17 veces más.
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

# Cliente Flutter: URL de la API. No se lee de este archivo; se pasa al compilar con
# flutter build web --dart-define=API_URL=http://localhost:8000
API_URL=http://localhost:8000
